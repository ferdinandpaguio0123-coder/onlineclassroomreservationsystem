:root{--ink:#172033;--muted:#64748b;--bg:#f1f5f9;--white:#fff;--line:#dbe3ee;--blue:#2563eb;--blue-dark:#1d4ed8;--teal:#0f766e;--purple:#7c3aed;--amber:#b45309;--green:#15803d;--red:#b91c1c;--radius:15px;--shadow:0 8px 24px rgba(15,23,42,.07)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 Inter,"Segoe UI",Arial,sans-serif}button,input{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:11px 16px;color:#fff;font-weight:700}button:disabled{opacity:.55;cursor:not-allowed}.site-header{background:#102a43;color:#fff;padding:22px 5%;box-shadow:var(--shadow)}.site-header h1{margin:0;color:#fff}.site-header p{margin:3px 0 0;color:#dbeafe}.container{width:min(1120px,92%);margin:auto}.card{margin:30px 0;background:var(--white);padding:26px;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.auth-card{max-width:520px;margin:42px auto}h2,h3{line-height:1.25}h2{margin-top:0}p{color:var(--muted)}label{display:block;margin:14px 0 6px;font-weight:700}input{width:100%;padding:12px;border:1px solid #bdc9d8;border-radius:9px;background:#fff}input:focus{outline:3px solid #bfdbfe;border-color:var(--blue)}.primary-button{background:var(--blue)}.primary-button:hover{background:var(--blue-dark)}.link-button{background:transparent;color:var(--blue);padding:10px 0;text-decoration:underline}.secondary-button,.logout-button{background:#475569}.dashboard-header{display:flex;justify-content:space-between;align-items:center;gap:16px}.navigation{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0;padding:12px;background:#eef2f7;border-radius:12px}.navigation button{background:#475569}.navigation .nav-dashboard{background:#2563eb}.navigation .nav-rooms{background:#0f766e}.navigation .nav-reservations{background:#b45309}.navigation .nav-history{background:#7c3aed}.navigation button.active{outline:3px solid #0f172a;outline-offset:2px;filter:brightness(.88)}.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}.stat-card{padding:20px;border-radius:12px;background:#eff6ff;border-left:5px solid var(--blue)}.stat-card span{display:block;color:var(--muted);font-weight:700}.stat-card strong{font-size:2rem;color:var(--blue)}.pending-stat{background:#fffbeb;border-color:#d97706}.pending-stat strong{color:#b45309}.room-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}.room-card{padding:20px;border:1px solid var(--line);border-radius:12px;background:#f8fafc}.room-card h4{margin:0;color:#0f766e;font-size:1.1rem}.booking-form{max-width:560px}.booking-form button{margin-top:16px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:13px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}th{background:#eaf0f8}.status{display:inline-block;padding:5px 11px;border-radius:20px;font-weight:800;font-size:.85rem}.status-pending{background:#fef3c7;color:#92400e}.status-approved{background:#dcfce7;color:#166534}.status-rejected{background:#fee2e2;color:#991b1b}.approve-button{background:#15803d;padding:8px 12px}.reject-button{background:#b91c1c;padding:8px 12px}.message{font-weight:650}.error{color:#b91c1c}.success{color:#15803d}.muted{color:var(--muted)}footer{text-align:center;padding:20px;color:var(--muted)}[hidden]{display:none!important}@media(max-width:600px){.dashboard-header{align-items:flex-start;flex-direction:column}.card{padding:18px}.navigation{display:grid;grid-template-columns:1fr 1fr}.navigation button{padding:10px 7px;font-size:.9rem}}
