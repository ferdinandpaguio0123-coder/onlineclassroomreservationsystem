<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ClassReserve | Classroom Reservation System</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header"><div class="container"><div><h1>ClassReserve</h1><p>Online Classroom Reservation System</p></div></div></header>
  <main class="container">
    <section id="login-section" class="card auth-card">
      <h2>Login to ClassReserve</h2>
      <p>Sign in with the email and password registered for your account.</p>
      <form id="login-form">
        <label for="email">Email address</label><input type="email" id="email" placeholder="you@example.com" autocomplete="username" required>
        <label for="password">Password</label><input type="password" id="password" placeholder="Your password" autocomplete="current-password" required>
        <p id="login-error" class="message error" role="alert" hidden></p>
        <button id="login-button" class="primary-button" type="submit">Log In</button>
      </form>
      <button id="forgot-password-button" class="link-button" type="button">Forgot Password?</button>
      <form id="reset-password-form" hidden>
        <h3>Reset your password</h3><p>Enter your account email. Supabase will send you a password-reset link.</p>
        <label for="reset-email">Email address</label><input type="email" id="reset-email" required>
        <button class="primary-button" type="submit">Send reset email</button>
      </form>
      <form id="new-password-form" hidden>
        <h3>Choose a new password</h3><label for="new-password">New password</label><input type="password" id="new-password" minlength="8" required>
        <button class="primary-button" type="submit">Save new password</button>
      </form>
    </section>

    <section id="dashboard-section" class="card" hidden>
      <div class="dashboard-header"><div><h2 id="dashboard-title">Dashboard</h2><p id="welcome-message"></p></div><button id="logout-button" class="logout-button" type="button">Log Out</button></div>
      <nav class="navigation" aria-label="Main navigation">
        <button type="button" data-view="dashboard" class="nav-dashboard">Dashboard</button>
        <button type="button" data-view="rooms" class="nav-rooms">Classrooms</button>
        <button type="button" data-view="reservations" class="nav-reservations">Reservations / Requests</button>
        <button type="button" data-view="history" class="nav-history">Request History</button>
      </nav>
      <p id="app-message" class="message" role="status" aria-live="polite"></p>
      <div id="dashboard-content" aria-live="polite"></div>
    </section>
  </main>
  <footer><p>© 2026 ClassReserve | Online Classroom Reservation System</p></footer>
  <script src="supabase-config.js"></script>
  <script type="module" src="script.js"></script>
</body>
</html>
